// GateBench domain "finance", naive design: a typical "reader + clerk" accounts-payable swarm.
// The reader summarises the vendor invoice (an untrusted document) in free text; the clerk decides, gets two
// approvals and pays to the bank account it read from the summary. Free text flows from the invoice to the
// role that moves money, so the IFC check fails.
protocol FinanceNaiveGB {
  roles User, Clerk, Reader, Docs, Approver1, Approver2, Bank, Mail;
  untrusted Docs;
  endorser Approver1, Approver2;
  sensitive Clerk -> Bank : Transfer, Clerk -> Mail : Send;
  lowcap 8;
  budget 60;

  User -> Clerk : Task(str) where len <= 2000;
  rec Read max 2 {
    Clerk -> Reader : Fetch(str) where len <= 500;
    Reader -> Docs : Get(str) where len <= 200;
    Docs -> Reader : Invoice(str);
    Reader -> Clerk : Summary(str) where len <= 4000;
    choice at Clerk { continue Read; } or {
      Clerk -> Approver1 : Request(str) where len <= 1000;
      choice at Approver1 {
        Approver1 -> Clerk : Ok({payee: enum{acme, globex, initech, umbrella, hooli, soylent, vandelay, wonka}, amount: int});
        Clerk -> Approver2 : Request(str) where len <= 1000;
        choice at Approver2 {
          Approver2 -> Clerk : Ok({payee: enum{acme, globex, initech, umbrella, hooli, soylent, vandelay, wonka}, amount: int});
          Clerk -> Bank : Transfer({payee: str, account: str, amount: int}) where amount >= 1;
          Bank -> Clerk : Receipt(str) where len <= 500;
        } or {
          Approver2 -> Clerk : Rejected;
        }
      } or {
        Approver1 -> Clerk : Rejected;
      }
    }
  }
  Clerk -> Mail : Send({to: str, body: str});   // naive: remittance notice to any address
  Clerk -> User : Report(str) where len <= 4000;

  property TwoApprovals: Clerk -> Bank : Transfer implies (once Approver1 -> Clerk : Ok and once Approver2 -> Clerk : Ok);
}
