/-
  swarmgate — command-line front-end.

    swarmgate check FILE.json            verify a protocol; prints a JSON report
    swarmgate serve FILE.json            run the gate as a JSON-lines server (stdin → stdout)
    swarmgate emit-lean FILE.json NAME   print a Lean module proving FILE's guarantees in the kernel

  `serve` executes `SwarmGate.monStep` — the very function the enforcement theorems are about.
-/
import SwarmGate

open Lean SwarmGate

def readSpec (path : String) : IO Spec := do
  let txt ← IO.FS.readFile path
  match Json.parse txt >>= Spec.ofJson with
  | .ok sp => pure sp
  | .error e => throw (IO.userError s!"cannot read protocol {path}: {e}")

/-! ### serve -/

structure Sess where
  m : MState
  taint : Nat

def taintList (P : Protocol) (T : Nat) : List Nat := (List.range P.nRoles).filter (fun k => T.testBit k)

def sessJson (sp : Spec) (s : Sess) : List (String × Json) :=
  [("state", s.m.s), ("count", s.m.count), ("halted", s.m.halted), ("final", sp.P.isFinal s.m.s),
   ("taint", toJson (taintList sp.P s.taint)),
   ("strikes", toJson (s.m.strikes.map (fun (a, b) => [a, b])))]

def freshSess (sp : Spec) : Sess :=
  ⟨MState.init sp.P, match sp.ifc with | some pol => taintInit pol | none => 0⟩

def handle (sp : Spec) (sessions : Std.HashMap String Sess) (j : Json) :
    Except String (Json × Std.HashMap String Sess) := do
  let op ← jstr (← jget j "op")
  let sid := ((jget j "session" >>= jstr).toOption).getD "default"
  let sess := (sessions.get? sid).getD (freshSess sp)
  match op with
  | "ping" => pure (Json.mkObj [("ok", true)], sessions)
  | "reset" => pure (Json.mkObj [("ok", true)], sessions.insert sid (freshSess sp))
  | "state" => pure (Json.mkObj (sessJson sp sess), sessions)
  | "kill" =>
    let (m', v) := monStep sp.cfg sp.P sess.m .kill
    let s' := { sess with m := m' }
    pure (Json.mkObj (("verdict", (v.toJson.getObjValD "verdict")) :: sessJson sp s'), sessions.insert sid s')
  | "send" =>
    let σ ← jnat (← jget j "sender")
    let e ← Event.ofJson (← jget j "event")
    -- the matched transition (for taint bookkeeping only; the decision is monStep's)
    let matched := (sp.P.out sess.m.s).find? (fun t => t.matches e)
    let (m', v) := monStep sp.cfg sp.P sess.m (.send σ e)
    let taint' := match v, matched, sp.ifc with
      | .deliver _, some t, some pol => taintUpd pol sess.taint t
      | _, _, _ => sess.taint
    let s' : Sess := ⟨m', taint'⟩
    let fields := match v.toJson with
      | .obj kvs => kvs.toList
      | _ => []
    pure (Json.mkObj (fields ++ sessJson sp s'), sessions.insert sid s')
  | o => throw s!"unknown op {o}"

partial def serveLoop (sp : Spec) (stdin : IO.FS.Stream) (stdout : IO.FS.Stream)
    (sessions : Std.HashMap String Sess) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  let line := line.trimRight
  if line.isEmpty then serveLoop sp stdin stdout sessions else
  let (resp, sessions') := match Json.parse line >>= handle sp sessions with
    | .ok r => r
    | .error e => (Json.mkObj [("error", e)], sessions)
  stdout.putStrLn resp.compress
  stdout.flush
  serveLoop sp stdin stdout sessions'

/-! ### emit-lean -/

def showLean {α : Type} [Repr α] (a : α) : String := (Std.Format.pretty (repr a) 100000000)

def emitLean (sp : Spec) (name : String) (native : Bool) : String := Id.run do
  let P := sp.P
  let tac := if native then "native_decide" else "decide +kernel"
  let lab := Trans.labelJson P sp.roles
  let mut s := s!"/- Generated by `swarmgate emit-lean` for protocol `{sp.name}`.\n" ++
    s!"   Every theorem below is checked by the Lean kernel{if native then " (via native_decide)" else ""}. -/\n" ++
    "import SwarmGate\nopen SwarmGate\n\n" ++
    s!"namespace Protocols.{name}\n\n" ++
    s!"/-- Roles: {sp.roles.toList} -/\n" ++
    s!"def P : Protocol := {showLean P}\n\n"
  let cg := exploreL [P.start] (fun s => (P.out s).map (fun t => (lab t, t.next))) fuel
  let V := cg.nodes.toList
  s := s ++ s!"def V : List Nat := {showLean V}\n\n"
  let mut i := 0
  for (nm, φ) in sp.props do
    i := i + 1
    let r := exploreL [(P.start, (none : MonSt))]
      (fun c => (P.out c.1).map (fun t => (lab t, (t.next, propUpd φ c.2 t)))) fuel
    if certifiesFast (propTS P φ) (propInv φ) r.nodes.toList then
      s := s ++ s!"/-- Property `{nm}` -/\ndef φ{i} : F := {showLean φ}\n" ++
        s!"def C{i} : List (Nat × MonSt) := {showLean r.nodes.toList}\n" ++
        s!"theorem φ{i}_certified : checkProp P φ{i} C{i} = true := by {tac}\n" ++
        s!"/-- `{nm}` holds after every delivered event, whatever the agents do. -/\n" ++
        s!"theorem φ{i}_holds (cfg : Config) (as : List Input) :\n" ++
        s!"    ∀ t e u, delivered (monRun cfg P (MState.init P) as).2 = t ++ e :: u →\n" ++
        s!"      satT φ{i} ((t ++ [e]).map Event.abs) = true :=\n" ++
        s!"  property_transfer P φ{i} C{i} φ{i}_certified cfg as\n\n"
  if let some pol := sp.ifc then
    let r := exploreL [(P.start, taintInit pol)]
      (fun c => (P.out c.1).map (fun t => (lab t, (t.next, taintUpd pol c.2 t)))) fuel
    if certifiesFast (taintTS P pol) (taintInv P pol) r.nodes.toList then
      s := s ++ s!"def pol : IFCPolicy := {showLean pol}\n" ++
        s!"def CT : List (Nat × Nat) := {showLean r.nodes.toList}\n" ++
        s!"theorem ifc_certified : checkIFC P pol CT = true := by {tac}\n" ++
        "/-- No tainted role ever performs a sensitive action, whatever the agents do. -/\n" ++
        "theorem ifc_holds (cfg : Config) (as : List Input) :\n" ++
        "    ∀ t e u, delivered (monRun cfg P (MState.init P) as).2 = t ++ e :: u →\n" ++
        "      pol.isSensitive e.abs = true → (taintOf P pol t).testBit e.src = false :=\n" ++
        "  ifc_transfer P pol CT ifc_certified cfg as\n\n"
  if let some ρ := longestRanking P V then
    if certifiesFast (cfgTS P) (boundInv P ρ) V then
      s := s ++ s!"def ρ : Ranking := {showLean ρ}\n" ++
        s!"theorem bounded_certified : checkBounded P ρ V = true := by {tac}\n" ++
        s!"/-- Every session delivers at most {rk ρ P.start} messages, whatever the agents do. -/\n" ++
        s!"theorem bounded (cfg : Config) (as : List Input) :\n" ++
        s!"    (delivered (monRun cfg P (MState.init P) as).2).length ≤ {rk ρ P.start} := by\n" ++
        s!"  have := bounded_length P ρ V bounded_certified cfg as\n" ++
        s!"  simpa [rk, ρ, P] using this\n\n"
  if let some D := sp.locals then
    let r := exploreL [(P.start, D.init)] (fun x => (jointMoves D x.2).map (fun jm =>
        (Json.null, (((globalFor P x.1 jm).map (·.next)).getD 0,
          (x.2.set jm.1 jm.2.1.next).set jm.2.2.1 jm.2.2.2.next)))) fuel
    if D.length == P.nRoles && certifiesFast (decTS P D) (decInv P D) r.nodes.toList then
      s := s ++ s!"/-- Per-role local protocols (sidecars), obtained by projection. -/\n" ++
        s!"def D : Deployment := {showLean D}\n" ++
        s!"def CD : List (Nat × List Nat) := {showLean r.nodes.toList}\n" ++
        s!"theorem decentralised_certified : checkDecentralised P D CD = true := by {tac}\n" ++
        "/-- Sidecars enforcing only their own role's local protocol never admit a non-protocol trace. -/\n" ++
        "theorem decentralised (t : List Event) (c : List Nat) (h : drun D D.init t = some c) : Pref P t :=\n" ++
        "  decentralised_sound P D CD decentralised_certified t c h\n\n"
  let W := mkWitnesses P V
  if certifiesFast (cfgTS P) (liveInv P W) V then
    s := s ++ s!"def W : Witnesses := {showLean W}\n" ++
      s!"theorem noStuck_certified : checkNoStuck P W V = true := by {tac}\n\n"
  s := s ++ s!"end Protocols.{name}\n"
  return s

/-! ### main -/

def usage : String :=
  "usage: swarmgate check FILE.json | serve FILE.json | admit POLICY.json FILE.json | emit-lean FILE.json NAME [--native]"

def main (args : List String) : IO UInt32 := do
  match args with
  | ["check", f] =>
    let sp ← readSpec f
    IO.println (checkReport sp).pretty
    return 0
  | ["serve", f] =>
    let sp ← readSpec f
    serveLoop sp (← IO.getStdin) (← IO.getStdout) {}
    return 0
  | "influence" :: f :: rest =>
    let sp ← readSpec f
    let extra := rest.filterMap (fun x => sp.roles.toList.idxOf? x)
    IO.println (influenceReport sp extra).pretty
    return 0
  | ["admit", pol, f] =>
    let ptxt ← IO.FS.readFile pol
    match Json.parse ptxt >>= MetaPolicy.ofJson with
    | .error e => IO.eprintln s!"cannot read meta-policy: {e}"; return 2
    | .ok (Pi, roles, names) =>
      let sp ← readSpec f
      -- role indices only mean something if the names agree: refuse instead of admitting a re-labelled protocol
      if sp.roles != roles then
        IO.println (Json.mkObj [("admitted", false), ("error",
          s!"role names differ from the interface: protocol {sp.roles.toList} vs interface {roles.toList}")]).pretty
        return 1
      IO.println (admitReport Pi roles names sp.P).pretty
      return 0
  | "emit-admit" :: pol :: f :: name :: rest =>
    let ptxt ← IO.FS.readFile pol
    match Json.parse ptxt >>= MetaPolicy.ofJson with
    | .error e => IO.eprintln s!"cannot read meta-policy: {e}"; return 2
    | .ok (Pi, roles, _) =>
      let sp ← readSpec f
      if sp.roles != roles then IO.eprintln "role names differ from the interface"; return 1
      let C := buildAdmitCert Pi sp.P
      if !admit Pi sp.P C then IO.eprintln "protocol is not admitted"; return 1
      let tac := if rest.contains "--native" then "native_decide" else "decide +kernel"
      IO.println (s!"/- Generated by `swarmgate emit-admit`: kernel-checked admission (Theorem T8) of protocol " ++
        s!"`{sp.name}` against interface roles {roles.toList}. -/\nimport SwarmGate\nopen SwarmGate\n\n" ++
        s!"namespace Admitted.{name}\n\ndef Pi : MetaPolicy := {showLean Pi}\n\n" ++
        s!"def P : Protocol := {showLean sp.P}\n\ndef C : AdmitCert := {showLean C}\n\n" ++
        s!"theorem admitted : admit Pi P C = true := by {tac}\n\n" ++
        "/-- Every enforced run of this protocol, against every adversary, stays inside the catalog, satisfies\n" ++
        "    the IFC policy, every required property and the length bound. -/\n" ++
        "def secure := admitted_secure Pi P C admitted\n\n" ++
        s!"end Admitted.{name}\n")
      return 0
  | "emit-lean" :: f :: name :: rest =>
    let sp ← readSpec f
    IO.println (emitLean sp name (rest.contains "--native"))
    return 0
  | _ => IO.eprintln usage; return 2
